# Canonical public HTTPS origin: DNS name, optional non-default port, no slash.
# Example only; replace with a domain you control before deployment.
MCP_PUBLIC_ORIGIN=https://mcp.example.com
# Default listener is loopback. Public exposure is an operator decision.
MCP_BIND_ADDRESS=127.0.0.1
MCP_HTTPS_PORT=8443
# WebAuthn RP ID is derived from the exact origin hostname automatically.
# Provider credentials are entered in /accounts, never placed in this file.
