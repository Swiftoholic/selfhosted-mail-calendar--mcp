worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/null crit;
events { worker_connections 64; }
http {
    access_log off;
    server_tokens off;
    client_max_body_size 32k;
    client_body_buffer_size 32k;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_header_timeout 5s;
    client_body_timeout 5s;
    send_timeout 10s;
    keepalive_timeout 5s;
    limit_req_zone $binary_remote_addr zone=owner_auth:1m rate=2r/s;
    limit_req_status 429;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 2s;
    upstream mcp_backend {
        zone mcp_backend 1m;
        server mcp:8082 resolve;
    }
    server { listen 8443 ssl default_server; ssl_reject_handshake on; }
    server {
        listen 8443 ssl;
        server_name __MCP_DOMAIN__;
        if ($http_host != "__MCP_HOST__") { return 421; }
        if ($request_method !~ ^(GET|POST)$) { return 405; }
        ssl_certificate /run/tls/fullchain.pem;
        ssl_certificate_key /run/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        location ~ ^/(mcp|login|accounts(?:/(status|check|save|manage/(check|save|retest|remove)|calendars(?:/(list|inspect|save|revoke))?|contacts(?:/(list|save|revoke))?))?|static/(login|accounts)\.(js|css)|\.well-known/(oauth-authorization-server|oauth-protected-resource/mcp)|oauth/(authorize|token)|auth/(status|grants(?:/revoke)?|setup/request|register/(options|verify)|login/(options|verify)|logout|revoke|consent))$ {
            limit_req zone=owner_auth burst=20 nodelay;
            proxy_pass http://mcp_backend;
            proxy_http_version 1.1;
            proxy_set_header Host "__MCP_HOST__";
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header Origin $http_origin;
            proxy_set_header Connection close;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Real-IP "";
            proxy_set_header Forwarded "";
            proxy_set_header X-Synthetic-Consent "";
            proxy_buffering off;
            proxy_request_buffering on;
            proxy_cache off;
            proxy_connect_timeout 2s;
            proxy_send_timeout 10s;
            proxy_read_timeout 30s;
            proxy_hide_header Server;
        }
        location / { return 404; }
    }
}
